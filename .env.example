# Discord Developer Portal에서 발급한 봇 토큰. 사용자 계정 토큰이 아님.
DISCORD_TOKEN=
# 응답을 허용할 Discord 사용자 ID. 쉼표로 구분하며 비어 있으면 실행을 거부함.
DISCORD_ALLOWED_USER_IDS=

MODEL_PROVIDER=lmstudio
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# check-model로 확인한 모델 ID를 입력
LMSTUDIO_MODEL=
# LM Studio 서버에서 인증을 켠 경우에만 입력
LMSTUDIO_API_KEY=
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_TOKENS=256
MODEL_TEMPERATURE=0.7

COMPANION_SYSTEM_PROMPT="너는 일상 대화를 나누는 AI 친구야. 한국어로 자연스럽게 한두 문장으로 답해. 모르는 개인 정보는 지어내지 마."
CONVERSATION_HISTORY_MESSAGES=20
DISCORD_QUEUE_SIZE=32
