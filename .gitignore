# 로컬 환경 설정과 인증 정보
.env
.env.*
!.env.example
.envrc
.pypirc

# Python 가상환경
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python 바이트코드와 네이티브 확장 빌드 결과
__pycache__/
*.py[codz]
*$py.class
*.so
*.pyd

# 패키지 빌드와 배포 산출물
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/

# 패키지 설치 로그
pip-log.txt
pip-delete-this-directory.txt

# 테스트 캐시와 커버리지 보고서
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# 정적 분석과 코드 검사 캐시
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.cache/

# 로컬 실행 데이터와 로그
data/
logs/
*.log
*.log.*
*.pid

# 로컬 데이터베이스와 SQLite 보조 파일
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Spyder 프로젝트 설정
.spyderproject
.spyproject

# Rope 프로젝트 설정
.ropeproject

# PyCharm
#   JetBrains 전용 템플릿은 별도의 JetBrains.gitignore로 관리되며,
#   https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore 에서 확인할 수 있다.
#   해당 템플릿을 전역 gitignore에 추가하거나 이 파일에 병합할 수 있다.
#   다만 공유할 프로젝트 설정까지 제외될 수 있으므로 권장하지 않는다.
.idea/

# Visual Studio Code
#   Visual Studio Code 전용 템플릿은 별도의 VisualStudioCode.gitignore로 관리되며,
#   https://github.com/github/gitignore/blob/main/Global/VisualStudioCode.gitignore 에서 확인할 수 있다.
#   해당 템플릿을 전역 gitignore에 추가하거나 이 파일에 병합할 수 있다.
.vscode/

# 편집기 임시 파일
*.swp
*.swo
*~
# 부분 코드 실행 시 생성되는 임시 파일
tempCodeRunnerFile.py

# 운영체제에서 생성하는 메타데이터
.DS_Store
._*
Thumbs.db
Desktop.ini

# .python-version과 의존성 잠금 파일은 재현 가능한 환경을 위해 추적한다.
